# Copy to /etc/cloudflared/config.yml and replace the tunnel UUID.
# Configure a DNS route for api.zchatauto.io.vn in Cloudflare.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: api.zchatauto.io.vn
    service: http://127.0.0.1:3000
  - service: http_status:404
