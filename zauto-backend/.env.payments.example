# Copy these settings into the EXISTING zauto-backend/.env; do not replace it.
# Keep ADMIN_USER_ID, JWT_SECRET, SMTP_*, ZALO_SESSION_KEY and other settings.
SEPAY_ENABLED=true
# Must be the actual accountNumber shown for the linked VPBank account in SePay.
SEPAY_BANK_ACCOUNT=0945785631
SEPAY_ACCOUNT_NAME=PHI TRONG DAT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in SePay -> Webhook -> HMAC-SHA256. NEVER commit the real key.
SEPAY_WEBHOOK_SECRET=
PAYMENT_PORT=3001
SEPAY_ORDER_TTL_MINUTES=30
# Only set if you intentionally use a SePay virtual account (VA).
SEPAY_SUB_ACCOUNT=
# Optional overrides in integer VND, controlled on the server (minimum 1000).
# SEPAY_PRICES_JSON={"extra10":20000,"extra30":50000}
# Default data path is zauto-backend/data/subscriptions.json.
# If SUBSCRIPTIONS_DATA_FILE is already set, both processes MUST use the same path.
